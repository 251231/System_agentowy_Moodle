# =============================================================================
# Moodle AI Router — Przykładowe Zmienne Środowiskowe
# =============================================================================
# Skopiuj ten plik jako .env w tym samym katalogu i uzupełnij klucze:
# cp .env.example .env

# ── OpenRouter (modele chmurowe: GPT, Claude, Gemini, Mistral...) ─────────────
# Pobierz klucz z: https://openrouter.ai/keys
OPENROUTER_API_KEY=twoj_klucz_openrouter_tutaj

# ── Lokalna Ollama ─────────────────────────────────────────────────────────────
# UWAGA: Gdy używasz Docker Compose, OLLAMA_BASE_URL jest ustawiony automatycznie
# w docker-compose.yml jako http://ollama:11434/v1 — NIE musisz tu nic wpisywać.
# Odkomentuj poniższe TYLKO jeśli uruchamiasz backend poza Dockerem (lokalnie):
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Cloudflare Zero Trust — tylko jeśli wystawiasz Ollamę publicznie przez tunel
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# ── Legacy API Keys (opcjonalne) ───────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=

# ── Baza danych (opcjonalne, domyślnie SQLite w app/db/database.py) ─────────────
# DATABASE_URL=postgresql://moodle:moodle_pass@localhost:5432/moodle_agents

# ── Bezpieczeństwo (JWT) ───────────────────────────────────────────────────────
SECRET_KEY="losowy-klucz-do-tokenow"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
